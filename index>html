<!DOCTYPE html>
<html lang="ne">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>NABIN - Rara Lake Nepal</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:Arial, sans-serif;
    background:#061a2b;
    color:white;
}

/* HEADER */
header{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:30px;

    background:
    linear-gradient(rgba(0,20,40,.55),rgba(0,10,25,.8)),
    url("https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=2000&q=80");

    background-size:cover;
    background-position:center;
}

.hero{
    max-width:900px;
}

.logo{
    font-size:25px;
    color:#00ffff;
    letter-spacing:8px;
    margin-bottom:20px;
}

h1{
    font-size:clamp(60px,12vw,130px);
    background:linear-gradient(
        90deg,
        #00ffff,
        #00ff88,
        #ffff00,
        #00bfff
    );

    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;

    text-shadow:0 0 30px #00ffff88;
}

.hero p{
    font-size:22px;
    margin:20px 0;
}

.btn{
    display:inline-block;
    padding:14px 30px;
    border-radius:30px;
    background:#00d9ff;
    color:#00121c;
    text-decoration:none;
    font-weight:bold;
    margin-top:20px;
    transition:.3s;
}

.btn:hover{
    transform:scale(1.1);
    box-shadow:0 0 30px #00ffff;
}

/* NAVBAR */
nav{
    position:sticky;
    top:0;
    z-index:100;
    background:#03101cdd;
    backdrop-filter:blur(10px);
    text-align:center;
    padding:15px;
}

nav a{
    color:white;
    text-decoration:none;
    margin:0 15px;
    font-weight:bold;
}

nav a:hover{
    color:#00ffff;
}

/* SECTION */
section{
    padding:70px 8%;
}

.title{
    text-align:center;
    font-size:42px;
    color:#00ffff;
    margin-bottom:40px;
}

/* INFO CARDS */
.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
}

.card{
    background:linear-gradient(145deg,#0b3048,#082235);
    padding:30px;
    border-radius:20px;
    text-align:center;
    border:1px solid #00ffff44;
    transition:.4s;
}

.card:hover{
    transform:translateY(-10px);
    box-shadow:0 0 30px #00ffff33;
}

.card h3{
    color:#00ffcc;
    margin-bottom:12px;
}

/* CONTENT */
.content{
    max-width:1000px;
    margin:auto;
    font-size:18px;
    line-height:1.8;
    color:#d8f7ff;
}

/* GALLERY */
.gallery{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}

.gallery img{
    width:100%;
    height:260px;
    object-fit:cover;
    border-radius:20px;
    transition:.4s;
}

.gallery img:hover{
    transform:scale(1.05);
    box-shadow:0 0 30px #00ffff66;
}

/* FOOTER */
footer{
    background:#020b12;
    text-align:center;
    padding:30px;
    color:#9edee8;
}

.nabin{
    color:#ff00cc;
    font-weight:bold;
}

/* MOBILE */
@media(max-width:600px){

    nav a{
        margin:0 6px;
        font-size:13px;
    }

    .hero p{
        font-size:17px;
    }

    .title{
        font-size:32px;
    }
}
</style>
</head>

